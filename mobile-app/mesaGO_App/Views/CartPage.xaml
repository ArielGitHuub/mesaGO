<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:mesaGO_App.ViewModels"
             x:Class="mesaGO_App.Views.CartPage"
             BackgroundColor="White">

    <ContentPage.BindingContext>
        <vm:CartViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" HeightRequest="60" BackgroundColor="White">
            <Label Text="CARRITO" TextColor="Black" FontSize="20" FontAttributes="Bold" 
                   HorizontalOptions="Center" VerticalOptions="Center"/>

            <ImageButton Command="{Binding GoToMenuCommand}" HorizontalOptions="End" Margin="0,0,15,0" BackgroundColor="Transparent" HeightRequest="40">
                <ImageButton.Source>
                    <FontImageSource Glyph="✕" Color="Black" Size="25"/>
                </ImageButton.Source>
            </ImageButton>
            <BoxView HeightRequest="1" Color="#f3f4f6" VerticalOptions="End"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,0,0,100">
                <VerticalStackLayout Padding="15" Spacing="5" BackgroundColor="White">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="📍" TextColor="#f36b01" FontSize="18"/>
                            <Label Text="Entregar en:" TextColor="#f36b01" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="Fray Leonardo Muriald..." TextColor="Gray" LineBreakMode="TailTruncation" Margin="5,0"/>
                        <Label Grid.Column="2" Text="Cambiar" TextColor="Black" FontAttributes="Bold" FontSize="12"/>
                    </Grid>
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="⏰" TextColor="#f36b01"/>
                        <Label Text="Cuando:" TextColor="#f36b01" FontAttributes="Bold"/>
                        <Label Text="30 min" TextColor="Gray"/>
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" Color="#f3f4f6" Margin="0,10,0,0"/>
                </VerticalStackLayout>

                <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 50" StrokeThickness="0" Margin="15,10" Padding="15">
                    <Grid ColumnDefinitions="Auto, *">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="🎫" TextColor="White"/>
                            <Label Text="¿Tienes un código?" TextColor="White" FontAttributes="Bold" FontSize="12"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="10">
                            <Label Text="Mi billetera" TextColor="White" FontAttributes="Bold" FontSize="12"/>
                            <Border IsVisible="{Binding HasItems}" BackgroundColor="#f36b01" StrokeShape="RoundRectangle 10" HeightRequest="20" WidthRequest="20" StrokeThickness="0">
                                <Label Text="1" TextColor="White" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout IsVisible="{Binding IsEmpty}" Spacing="20" Padding="30" VerticalOptions="Center">
                    <Grid HeightRequest="120" WidthRequest="120" HorizontalOptions="Center">
                        <Label Text="🛍️" FontSize="100" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" Opacity="0.5"/>
                        <Border BackgroundColor="#f36b01" StrokeShape="RoundRectangle 20" HeightRequest="30" WidthRequest="30" 
                                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,10,10" StrokeThickness="2" Stroke="White">
                            <Label Text="+" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                        </Border>
                    </Grid>

                    <Label Text="TU CARRITO ESTÁ VACÍO" TextColor="Black" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="¿Qué esperas? Explora nuestro menú y empieza a comprar." TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                    <Button Text="Explorar menú" 
                            Command="{Binding GoToMenuCommand}"
                            BackgroundColor="#1A1A1A" 
                            TextColor="White" 
                            CornerRadius="25" 
                            HeightRequest="50" 
                            FontAttributes="Bold"
                            Margin="0,20,0,0"/>
                </VerticalStackLayout>

                <CollectionView ItemsSource="{Binding CartItems}" IsVisible="{Binding HasItems}" Margin="0,10,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="90, *" Padding="15,10">
                                <Image Grid.Column="0" Source="{Binding Imagen}" Aspect="AspectFit" HeightRequest="80" WidthRequest="80"/>

                                <VerticalStackLayout Grid.Column="1" Spacing="5">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" Text="{Binding Nombre}" TextColor="Black" FontAttributes="Bold" FontSize="14" TextTransform="Uppercase"/>
                                        <Label Grid.Column="1" Text="{Binding Precio, StringFormat='${0:F2}'}" TextColor="Black" FontAttributes="Bold" FontSize="16"/>
                                    </Grid>

                                    <Label Text="{Binding Descripcion}" TextColor="Gray" FontSize="10" LineBreakMode="TailTruncation"/>

                                    <Grid ColumnDefinitions="Auto, *" Margin="0,10,0,0">

                                        <HorizontalStackLayout Spacing="15">
                                            <Border Stroke="#e5e7eb" StrokeShape="RoundRectangle 20" HeightRequest="35" WidthRequest="35" StrokeThickness="1">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=DecreaseQtyCommand}" CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="-" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20"/>
                                            </Border>

                                            <Label Text="{Binding Quantity}" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" FontSize="16"/>

                                            <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 20" HeightRequest="35" WidthRequest="35" StrokeThickness="0">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=IncreaseQtyCommand}" CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="+" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18"/>
                                            </Border>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="15" VerticalOptions="Center">
                                            <Label Text="Editar" TextColor="Black" FontSize="12" TextDecorations="Underline"/>
                                            <Label Text="Eliminar" TextColor="Black" FontSize="12" TextDecorations="Underline">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=RemoveItemCommand}" CommandParameter="{Binding .}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Padding="20" BackgroundColor="Transparent" IsVisible="{Binding HasItems}">
            <Button Text="{Binding GrandTotal, StringFormat='Ir a pagar      $ {0:F2}'}"
                    Command="{Binding CheckoutCommand}"
                    BackgroundColor="#f36b01"
                    TextColor="White"
                    CornerRadius="30"
                    HeightRequest="60"
                    FontAttributes="Bold"
                    FontSize="18"
                    Shadow="{Shadow Brush=Black, Offset='0,5', Radius=10, Opacity=0.3}"/>
        </Grid>

    </Grid>
</ContentPage>