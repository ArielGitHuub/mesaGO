<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:mesaGO_App.ViewModels"
             x:Class="mesaGO_App.Views.ProfilePage"
             BackgroundColor="#f9fafb"
             Title="Perfil"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:ProfileViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20, 20, 20, 50" Spacing="20">

            <Grid ColumnDefinitions="Auto, *">
                <HorizontalStackLayout Spacing="4" HeightRequest="24" VerticalOptions="Center">
                    <BoxView Color="#f36b01" WidthRequest="6" VerticalOptions="Fill"/>
                    <BoxView Color="#f36b01" WidthRequest="6" VerticalOptions="Fill"/>
                    <BoxView Color="#f36b01" WidthRequest="6" VerticalOptions="Fill"/>
                </HorizontalStackLayout>

                <Label Grid.Column="1" Text="{Binding AppVersion}" TextColor="Gray" FontSize="12" HorizontalOptions="End" VerticalOptions="Center"/>
            </Grid>

            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                <Frame Grid.Column="0" HeightRequest="60" WidthRequest="60" CornerRadius="30" Padding="0" HasShadow="False" BorderColor="#e5e7eb" BackgroundColor="White" VerticalOptions="Center">
                    <Label Text="👤" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#0f172a"/>
                </Frame>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="HOLA, ARIEL!" TextColor="#0f172a" FontSize="20" FontAttributes="Bold" TextTransform="Uppercase"/>
                    <Label Text="{Binding UserEmail}" TextColor="Gray" FontSize="14"/>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="10">
                <Label Text="Cuenta" TextColor="Gray" FontSize="14" FontAttributes="Bold"/>

                <Frame BackgroundColor="White" CornerRadius="12" Padding="0" HasShadow="True" BorderColor="#f1f5f9">
                    <VerticalStackLayout>

                        <Grid Padding="15" ColumnDefinitions="Auto, *, Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToOptionCommand}" CommandParameter="Editar Perfil"/>
                            </Grid.GestureRecognizers>
                            <Label Text="✏️" FontSize="20" TextColor="Gray" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Editar perfil" TextColor="#334155" FontSize="16" VerticalOptions="Center" Margin="15,0"/>
                            <Label Grid.Column="2" Text="›" TextColor="Gray" FontSize="20" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" Margin="15,0"/>

                        <Grid Padding="15" ColumnDefinitions="Auto, *, Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToOptionCommand}" CommandParameter="Pedidos"/>
                            </Grid.GestureRecognizers>
                            <Label Text="🍔" FontSize="20" TextColor="Gray" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Pedidos" TextColor="#334155" FontSize="16" VerticalOptions="Center" Margin="15,0"/>
                            <Label Grid.Column="2" Text="›" TextColor="Gray" FontSize="20" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" Margin="15,0"/>

                        <Grid Padding="15" ColumnDefinitions="Auto, *, Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToOptionCommand}" CommandParameter="Datos para la factura"/>
                            </Grid.GestureRecognizers>
                            <Label Text="📄" FontSize="20" TextColor="Gray" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Datos para la factura" TextColor="#334155" FontSize="16" VerticalOptions="Center" Margin="15,0"/>
                            <Label Grid.Column="2" Text="›" TextColor="Gray" FontSize="20" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" Margin="15,0"/>

                        <Grid Padding="15" ColumnDefinitions="Auto, *, Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToOptionCommand}" CommandParameter="Dirección de entrega"/>
                            </Grid.GestureRecognizers>
                            <Label Text="📍" FontSize="20" TextColor="Gray" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Dirección de entrega" TextColor="#334155" FontSize="16" VerticalOptions="Center" Margin="15,0"/>
                            <Label Grid.Column="2" Text="›" TextColor="Gray" FontSize="20" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" Margin="15,0"/>

                        <Grid Padding="15" ColumnDefinitions="Auto, *, Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToOptionCommand}" CommandParameter="Notificaciones"/>
                            </Grid.GestureRecognizers>
                            <Label Text="🔔" FontSize="20" TextColor="Gray" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Notificaciones" TextColor="#334155" FontSize="16" VerticalOptions="Center" Margin="15,0"/>
                            <Label Grid.Column="2" Text="›" TextColor="Gray" FontSize="20" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" Margin="15,0"/>

                        <Grid Padding="15" ColumnDefinitions="Auto, *, Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToOptionCommand}" CommandParameter="Ayuda"/>
                            </Grid.GestureRecognizers>
                            <Label Text="❓" FontSize="20" TextColor="Gray" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Ayuda" TextColor="#334155" FontSize="16" VerticalOptions="Center" Margin="15,0"/>
                            <Label Grid.Column="2" Text="›" TextColor="Gray" FontSize="20" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" Margin="15,0"/>

                        <Grid Padding="15" ColumnDefinitions="Auto, *">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LogoutCommand}"/>
                            </Grid.GestureRecognizers>
                            <Label Text="🚪" FontSize="20" TextColor="#f36b01" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Cerrar sesión" TextColor="#f36b01" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" Margin="15,0"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <Label Text="¿Eres Administrador?" 
                   TextColor="#94a3b8" 
                   FontSize="12" 
                   FontAttributes="Bold"
                   TextDecorations="Underline"
                   HorizontalOptions="Center" 
                   Margin="0,20,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AdminLoginCommand}"/>
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>