<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:mesaGO_App.ViewModels"
             x:Class="mesaGO_App.Views.LoginPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <Grid IsClippedToBounds="True">
            <Path Fill="#f36b01" Opacity="0.9"
                  Data="M44.7,-76.4C58.9,-69.2,71.8,-59.1,81.6,-46.6C91.4,-34.1,98.1,-19.2,95.8,-5.1C93.5,9,82.2,22.4,71.2,33.4C60.2,44.4,49.5,53,38.1,60.6C26.7,68.2,14.6,74.8,1.3,72.6C-12,70.4,-26.6,59.4,-39.8,49.3C-53,39.2,-64.8,30,-72.6,18.1C-80.4,6.2,-84.2,-8.4,-79.8,-21.5C-75.4,-34.6,-62.8,-46.2,-49.5,-53.8C-36.2,-61.4,-22.1,-65,-8.3,-64.8C5.5,-64.6,11,-60.6,30.5,-76.4Z"
                  HorizontalOptions="End" VerticalOptions="Start"
                  TranslationX="100" TranslationY="-100" Scale="2.5" />

            <Path Fill="#c25601" Opacity="0.9"
                  Data="M39.9,-65.7C50.8,-60.3,58.3,-47.8,64.7,-35.4C71.1,-23,76.4,-10.8,74.9,0.9C73.4,12.5,65.1,23.6,56.5,33.4C47.9,43.2,39.1,51.8,28.9,58.1C18.7,64.4,7.2,68.4,-3.8,75C-14.8,81.6,-25.2,90.8,-33.5,86.8C-41.8,82.8,-47.9,65.6,-56.3,51.4C-64.7,37.2,-75.4,26,-78.9,13.1C-82.5,0.2,-78.9,-14.4,-71.4,-26.8C-63.9,-39.2,-52.5,-49.4,-40.5,-54.3C-28.5,-59.2,-15.9,-58.8,-2.6,-54.3C10.7,-49.8,21.4,-41.2,39.9,-65.7Z"
                  HorizontalOptions="Start" VerticalOptions="End"
                  TranslationX="-100" TranslationY="100" Scale="3" />
        </Grid>

        <ScrollView>
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="320" Spacing="30" Padding="0,50">

                <Label Text="Login Administrador" TextColor="#0f172a" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <Frame Grid.Column="0" BackgroundColor="White" CornerRadius="30" Padding="0" HasShadow="True" BorderColor="#e5e7eb">
                        <VerticalStackLayout>

                            <Grid Padding="20" ColumnDefinitions="30, *">
                                <Label Text="👤" TextColor="#f36b01" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" Text="{Binding Email}" Placeholder="Usuario (Email)" PlaceholderColor="Gray" TextColor="#0f172a" FontAttributes="Bold" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#f1f5f9"/>

                            <Grid Padding="20" ColumnDefinitions="30, *">
                                <Label Text="🔒" TextColor="#f36b01" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" Text="{Binding Password}" IsPassword="True" Placeholder="Contraseña" PlaceholderColor="Gray" TextColor="#0f172a" FontAttributes="Bold" />
                            </Grid>

                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="End" VerticalOptions="Center"
                       HeightRequest="70" WidthRequest="70" CornerRadius="35" Padding="0"
                       BackgroundColor="#f36b01" HasShadow="True" BorderColor="White" Margin="0,0,-10,0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LoginCommand}"/>
                        </Frame.GestureRecognizers>
                        <Label Text="➜" TextColor="White" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                </Grid>

                <Frame IsVisible="{Binding HasError}" BackgroundColor="#fef2f2" BorderColor="#fecaca" Padding="15,10" CornerRadius="12" HasShadow="False">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="⚠️" TextColor="#ef4444" VerticalOptions="Center"/>
                        <Label Text="{Binding ErrorMessage}" TextColor="#ef4444" FontSize="13" VerticalOptions="Center" LineBreakMode="WordWrap"/>
                    </HorizontalStackLayout>
                </Frame>

                <Button Text="Volver al Perfil" 
                        Command="{Binding GoBackCommand}" 
                        BackgroundColor="Transparent" 
                        TextColor="#f36b01"
                        BorderColor="#f36b01"
                        BorderWidth="2"
                        CornerRadius="25"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Margin="0,20,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>