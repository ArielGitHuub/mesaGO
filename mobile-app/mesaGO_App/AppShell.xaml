<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="mesaGO_App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:mesaGO_App.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="mesaGO_App">

    <Shell.Resources>
        <Style x:Key="BaseStyle" TargetType="Element">
            <Setter Property="Shell.BackgroundColor" Value="Black" />
            <Setter Property="Shell.ForegroundColor" Value="White" />
            <Setter Property="Shell.TitleColor" Value="White" />
            <Setter Property="Shell.DisabledColor" Value="#B4FFFFFF" />
            <Setter Property="Shell.UnselectedColor" Value="#959595" />
            <Setter Property="Shell.TabBarBackgroundColor" Value="Black" />
            <Setter Property="Shell.TabBarForegroundColor" Value="White" />
            <Setter Property="Shell.TabBarUnselectedColor" Value="#959595" />
            <Setter Property="Shell.TabBarTitleColor" Value="#f36b01" />
        </Style>
        <Style TargetType="TabBar" BasedOn="{StaticResource BaseStyle}" />
        <Style TargetType="FlyoutItem" BasedOn="{StaticResource BaseStyle}" />
    </Shell.Resources>

    <TabBar>
        <Tab Title="Inicio" Icon="">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" Route="HomePage" />
        </Tab>

        <Tab Title="Cupones" Icon="">
            <ShellContent ContentTemplate="{DataTemplate views:CouponsPage}" Route="CouponsPage" />
        </Tab>

        <Tab Title="Carrito" Icon="">
            <ShellContent ContentTemplate="{DataTemplate views:CartPage}" Route="CartPage" />
        </Tab>

        <Tab Title="Reservas" Icon="">
            <ShellContent ContentTemplate="{DataTemplate views:ReservationPage}" Route="ReservationPage" />
        </Tab>

        <Tab Title="Perfil" Icon="">
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" Route="ProfilePage" />
        </Tab>
    </TabBar>

</Shell>